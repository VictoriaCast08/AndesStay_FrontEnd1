# =====================================================================
# AndesStay — variables de entorno (ejemplo)
# Copia este archivo en `.env` y rellena los valores. El `.env` real
# NUNCA se sube al repositorio (está en .gitignore).
# =====================================================================

# --- Microsoft Entra ID (App Registration tipo Single-page application) ---
# Application (client) ID de la app SPA de Entra ID
AZURE_CLIENT_ID=POR_RELLENAR_AZURE_CLIENT_ID
# 'common' permite login multitenant (cualquier tenant de Entra ID),
# alineado con NimbusJwtDecoder del BFF.
AZURE_TENANT_ID=common
# URL del frontend (localhost en dev; S3/CloudFront/EC2 en producción)
AZURE_REDIRECT_URI=http://localhost:4200
AZURE_POST_LOGOUT_URI=http://localhost:4200

# --- App Registration API (expone el BFF; es la audiencia 'aud' del JWT) ---
API_CLIENT_ID=POR_RELLENAR_API_CLIENT_ID
API_SCOPE=access_as_user

# --- Backend: AWS API Gateway -> BFF (puerto 8080 del EC2) ---
# Nunca apuntar directamente a puertos internos 8081-8085 de microservicios.
# Desarrollo: http://<EC2_BACKEND_IP>:8080/api
# Producción: https://<API_GATEWAY_ID>.execute-api.<region>.amazonaws.com/<stage>/api
API_BASE_URL=http://localhost:8080/api