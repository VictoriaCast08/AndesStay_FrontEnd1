# Datos de tu App Registration en Microsoft Entra ID
# Copia estos valores a src/environments/environment.ts
#
# clientId de la SPA (frontend)
VITE_AZURE_CLIENT_ID=<spa-client-id>
# tenant
VITE_AZURE_TENANT_ID=<tenant-id>
# Redirect URI SPA (debe coincidir con Entra)
VITE_AZURE_REDIRECT_URI=http://localhost:4200
# clientId de la API expuesta (audience del BFF)
VITE_AZURE_API_CLIENT_ID=<api-client-id>
# Scope expuesto por la API, p.ej. access_as_user
VITE_AZURE_API_SCOPE=access_as_user
# Base URL del BFF AndesStay
VITE_API_BASE_URL=http://localhost:8080
